{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/student",
      "destination": "/client/student.html"
    },
    {
      "source": "/admin",
      "destination": "/client/admin.html"
    },
    {
      "source": "/(.*)",
      "destination": "/client/$1"
    }
  ]
}
