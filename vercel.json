{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/student",
      "dest": "client/student.html"
    },
    {
      "src": "/admin",
      "dest": "client/admin.html"
    },
    {
      "src": "/(.*)",
      "dest": "client/$1"
    }
  ]
}
